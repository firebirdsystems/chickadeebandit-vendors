{
  "id": "vendors",
  "name": "Vendor Recommendations",
  "version": "1.1.0",
  "description": "Community-curated directory of local contractors, handymen, landscapers, and service providers. Any member can add a vendor with contact info and a review; others can upvote or add their own.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": ["vendors", "contractors", "recommendations", "directory", "local", "services"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "adults",
    "requires_approval": false
  },
  "storage": "db",
  "nav": {
    "label": "Vendors"
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🏪",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["all_vendors"]
  },
  "row_policies": {
    "vendors": {
      "kind": "owner_or_visibility",
      "member_column": "added_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"]
    },
    "reviews": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"]
    },
    "review_upvotes": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"]
    }
  }
}
