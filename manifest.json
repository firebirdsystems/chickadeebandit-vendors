{
  "id": "vendors",
  "contexts": ["household", "shared_space"],
  "name": "Vendor Recommendations",
  "version": "1.0.1",
  "description": "Community-curated directory of local contractors, handymen, landscapers, and service providers. Any member can add a vendor with contact info and a review; others can upvote or add their own.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": ["vendors", "contractors", "recommendations", "directory", "local", "services"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "adults",
    "requires_approval": false
  },
  "storage": "db",
  "automation_actions": {
    "add_vendor": {
      "title": "Add a vendor to the directory",
      "description": "Record a trade or service when another app's event fires — whoever handled a maintenance request, a repair, or a recommended job.",
      "params": {
        "added_by": {
          "type": "member",
          "label": "Added by",
          "required": true
        },
        "name": {
          "type": "text",
          "label": "Business name",
          "required": true
        },
        "category": {
          "type": "text",
          "label": "Trade",
          "default": "Other",
          "options": ["Contractor", "Handyman", "HVAC", "Landscaper", "Painter", "Plumber", "Electrician", "Septic", "Trash", "Service", "Other"]
        },
        "phone": {
          "type": "text",
          "label": "Phone",
          "default": ""
        }
      },
      "dedupe": {
        "table": "vendors",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "vendors",
          "values": {
            "id": "$uuid",
            "name": ":name",
            "category": ":category",
            "phone": ":phone",
            "added_by": ":added_by",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "publishes": ["vendor.added"],
  "publish_acls": {"vendor.added": {"require_role": "member"}},
  "nav": {
    "label": "Vendors"
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🏪",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["all_vendors"]
  },
  "member_references": {
    "vendors": { "column": "added_by", "on_removed": "keep" },
    "reviews": { "column": "member_id", "on_removed": "keep" },
    "review_upvotes": { "column": "member_id", "on_removed": "delete", "id_column": "rowid" }
  },
  "row_policies": {
    "vendors": {
      "kind": "owner_or_visibility",
      "member_column": "added_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"]
    },
    "reviews": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": ["vendor_id"],
        "limit": 1
      }
    },
    "review_upvotes": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": ["review_id"],
        "limit": 1
      }
    }
  }
}
